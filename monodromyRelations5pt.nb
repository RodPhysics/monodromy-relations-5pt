Cell["Assembling the relation", "Section",ExpressionUUID->"c3df9373-c781-41bc-8087-af7a7d5bf328"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CfacNF", "[", 
   RowBox[{"k_", ",", " ", "n_", ",", " ", "w_"}], "]"}], "         ", ":=", 
  " ", 
  RowBox[{
   RowBox[{"CfacNF", "[", 
    RowBox[{"k", ",", "n", ",", "w"}], "]"}], "      ", "=", " ", 
   RowBox[{"toNF", "[", 
    RowBox[{
     RowBox[{"Cfac", "[", 
      RowBox[{"k", ",", "n", ",", "w"}], "]"}], ",", " ", "w"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"MfacNF", "[", 
   RowBox[{"j_", ",", " ", "n_", ",", " ", "w_"}], "]"}], "         ", ":=", 
  " ", 
  RowBox[{
   RowBox[{"MfacNF", "[", 
    RowBox[{"j", ",", "n", ",", "w"}], "]"}], "      ", "=", " ", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"mulNF", "[", 
       RowBox[{"#1", ",", "#2", ",", "w"}], "]"}], "&"}], ",", " ", "1", ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"CfacNF", "[", 
        RowBox[{"#", ",", "n", ",", "w"}], "]"}], "&"}], " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"j", ",", "3", ",", 
        RowBox[{"-", "1"}]}], "]"}]}]}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"ZserNF", "[", 
   RowBox[{"tau_", ",", " ", "rho_", ",", " ", "n_", ",", " ", "w_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{
   RowBox[{"ZserNF", "[", 
    RowBox[{"tau", ",", "rho", ",", "n", ",", "w"}], "]"}], " ", "=", " ", 
   RowBox[{"toNF", "[", 
    RowBox[{
     RowBox[{"Zser", "[", 
      RowBox[{"tau", ",", "rho", ",", "n", ",", "w"}], "]"}], ",", " ", "w"}],
     "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phaseNF", "[", 
    RowBox[{"i_", ",", " ", "j_", ",", " ", "sg_", ",", " ", "w_"}], "]"}], 
   "   ", ":=", " ", 
   RowBox[{"toNF", "[", 
    RowBox[{
     RowBox[{"phaseE", "[", 
      RowBox[{"i", ",", "j", ",", "sg", ",", "w"}], "]"}], ",", " ", "w"}], 
    "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MonRelNF", "[", 
    RowBox[{"rho_", ",", " ", "n_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
   RowBox[{"NF", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"mulNF", "[", 
      RowBox[{
       RowBox[{"ZserNF", "[", 
        RowBox[{
         RowBox[{"tauP", "[", 
          RowBox[{"1", ",", "n"}], "]"}], ",", "rho", ",", "n", ",", "w"}], 
        "]"}], ",", " ", 
       RowBox[{"phaseNF", "[", 
        RowBox[{"1", ",", "2", ",", 
         RowBox[{"+", "1"}], ",", "w"}], "]"}], ",", " ", "w"}], "]"}], "\n", 
     "  ", "+", " ", 
     RowBox[{"ZserNF", "[", 
      RowBox[{
       RowBox[{"tauP", "[", 
        RowBox[{"2", ",", "n"}], "]"}], ",", "rho", ",", "n", ",", "w"}], 
      "]"}], "\n", "  ", "+", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"mulNF", "[", 
        RowBox[{
         RowBox[{"ZserNF", "[", 
          RowBox[{
           RowBox[{"tauP", "[", 
            RowBox[{"j", ",", "n"}], "]"}], ",", "rho", ",", "n", ",", "w"}], 
          "]"}], ",", " ", 
         RowBox[{"MfacNF", "[", 
          RowBox[{"j", ",", "n", ",", "w"}], "]"}], ",", " ", "w"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3", ",", " ", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "one", " ", "scalar", " ", "relation", " ", "per", " ", "basis", " ", 
    "word"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"MonEqs", "[", 
   RowBox[{"rho_", ",", " ", "n_", ",", " ", "w_"}], "]"}], " ", ":=", " ", 
  RowBox[{"nfCollect", "[", 
   RowBox[{"MonRelNF", "[", 
    RowBox[{"rho", ",", " ", "n", ",", " ", "w"}], "]"}], "]"}]}]}], "Input",

Cell[CellGroupData[{

Cell["The 100 Z-integrals", "Section",ExpressionUUID->"89060241-57e1-4c32-a1a1-a1e43361b551"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", "few", " ", 
     RowBox[{"minutes", ":", " ", 
      RowBox[{"100", " ", "integrals"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"each", " ", "split", " ", "into", " ", "5", " ", "sector"}], "-", 
     RowBox[{"decomposed", " ", "pieces"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tZ", ",", " ", "zVals"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", "\n", "   ", 
      RowBox[{"Association", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "->", " ", 
           RowBox[{
            RowBox[{"ZNum", "[", 
             RowBox[{
              RowBox[{"Sequence", " ", "@@", " ", 
               RowBox[{"(", 
                RowBox[{"List", " ", "@@", " ", "#"}], ")"}]}], ",", " ", 
              "sMon"}], "]"}], "[", "\"\<value\>\"", "]"}]}], ")"}], " ", 
         "&"}], " ", "/@", " ", "zList"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   
   RowBox[{
    RowBox[{"maxZ", " ", "=", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"N", "[", 
        RowBox[{"Values", "[", "zVals", "]"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<evaluated \>\"", ",", " ", 
         RowBox[{"Length", "[", "zVals", "]"}], ",", 
         " ", "\"\< integrals in \>\"", ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{"tZ", ",", " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], 
        "}"}], "]"}], ",", "\n", "  ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<failures : \>\"", ",", " ", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Values", "[", "zVals", "]"}], ",", " ", "$Failed"}], 
          "]"}]}], "}"}], "]"}], ",", "\n", "  ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<max |Z|  : \>\"", ",", " ", "maxZ"}], "}"}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ",", " ", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"N", "[", 
                 RowBox[{"Last", "[", "#", "]"}], "]"}], ",", " ", "12"}], 
               "]"}]}], "}"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Normal", "[", "zVals", "]"}]}], ",", "\n", "       ", 
          RowBox[{"{", 
           RowBox[{"\"\<Z\>\"", ",", " ", "\"\<value\>\""}], "}"}]}], "]"}], ",",
         " ", 
        RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
        RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "}"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"41da04e1-b82b-4838-83ad-bc554d9bedb6"],


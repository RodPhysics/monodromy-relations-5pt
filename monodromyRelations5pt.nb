           RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "1", ",", " ", 
          RowBox[{"n", "-", "3"}]}], "}"}]}], "]"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"string", " ", "labels"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lblChar", "[", "m_Integer", "]"}], " ", ":=", " ", 
    RowBox[{"ToString", "[", "m", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"wordStr", "[", "w_List", "]"}], " ", ":=", " ", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"lblChar", " ", "/@", " ", "w"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"permStr", "[", "p_List", "]"}], " ", ":=", " ", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"ToString", " ", "/@", " ", "p"}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Labels", " ", "travel", " ", "with", " ", "the", " ", 
      RowBox[{"chamber", ".", "  ", "The"}], " ", "letter", " ", "sitting", " ",
       "in", " ", "slot", " ", "k", " ", "of", " ", 
      RowBox[{"Z", "^", "tau"}], " ", "is", "\n", "   ", 
      RowBox[{"Perm", "[", 
       RowBox[{"tau", ",", " ", "."}], "]"}], " ", "of", " ", "the", " ", 
      "reference", " ", "letter"}], ",", " ", 
     RowBox[{
     "so", " ", "its", " ", "singularity", " ", "is", " ", "at", " ", 
      "puncture", "\n", "   ", 
      RowBox[{"tau", "[", 
       RowBox[{"[", "l", "]"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"not", " ", "l"}], ";", " ", 
      RowBox[{
      "the", " ", "integrated", " ", "variable", " ", "is", " ", "the", " ", 
       "position", " ", "of", " ", 
       RowBox[{
        RowBox[{"tau", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"lblPerm", "[", 
     RowBox[{"tau_", ",", " ", "w_List"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"tau", "[", 
       RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", "w"}]}], "\n", 
   RowBox[{
    RowBox[{"Zsym", "[", 
     RowBox[{"tau_", ",", " ", "rho_", ",", " ", "ww_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Zc", "[", 
     RowBox[{
      RowBox[{"permStr", "[", "tau", "]"}], ",", " ", 
      RowBox[{"permStr", "[", "rho", "]"}], ",", "\n", "  ", 
      RowBox[{"Sequence", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"wordStr", "[", 
           RowBox[{"lblPerm", "[", 
            RowBox[{"tau", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@",
          " ", "ww"}], ")"}]}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "symbolic", " ", "generating", " ", "series"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"Zser", "[", 
     RowBox[{"tau_", ",", " ", "rho_", ",", " ", "n_", ",", " ", "w_"}], 
     "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"NCExpand", "[", 

     FractionBox["7", "20"]},
    {
     RowBox[{"s", "[", 
      RowBox[{"1", ",", "3"}], "]"}], 
     FractionBox["1", "10"]},
    {
     RowBox[{"s", "[", 
      RowBox[{"2", ",", "4"}], "]"}], 
     RowBox[{"-", 
      FractionBox["7", "20"]}]},
    {
     RowBox[{"s", "[", 
      RowBox[{"2", ",", "5"}], "]"}], 
     RowBox[{"-", 
      FractionBox["3", "20"]}]},
    {
     RowBox[{"s", "[", 
      RowBox[{"1", ",", "4"}], "]"}], 
     RowBox[{"-", 
      FractionBox["13", "20"]}]},
    {
     RowBox[{"s", "[", 
      RowBox[{"3", ",", "5"}], "]"}], 
     RowBox[{"-", 
      FractionBox["4", "5"]}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},

Notebook[{
Cell["Five-point monodromy relations at weight 2", "Title",ExpressionUUID->"9d24a8a7-b1b5-4a4e-85ae-e96444ce3e36"],

Cell["\<\
Derivation of the five-point monodromy relations for AdS string integrals, \
truncated at weight Wmax = 2 in the braid generators.  Running this notebook \
top to bottom writes monEqs5_W2.m, the data file consumed by \
numericalChecks5pt.nb.

Requires NCAlgebra, PolyLogTools and HPL.  (The numerical check needs none of \
them -- only this derivation does.)

The relation implemented is

    Z(tau_1|rho) e^{i pi E_12} + Z(I_n|rho)
      + Sum_{j=3}^{n-1} Z(tau_j|rho) prodL_{k=3}^{j} C_{2->k} = 0,

with chambers tau_1 = (2 1 3 ... n), tau_2 = I_n, tau_j = (1 3 ... j 2 j+1 \
... n), and crossing factors C_{2->k} = Phi(e_2k, tauhat_k(e^<_{k-1})) e^{-i \
pi E_2k} Phi(tauhat_{k-1}(e^<_{k-1}), e_2k).  Expanding in the PBW basis of \
the braid algebra turns it into one scalar equation per basis word: 25 of \
them at weight 2, in 100 distinct Z-integrals.\
\>", "Text",ExpressionUUID->"2a679758-537d-4125-8fb6-f912511bc00d"],

Cell["Preamble", "Section",ExpressionUUID->"98b5641a-168a-46a9-9362-b107149d70ab"],

Cell["\<\
$HPLPath = FileNameJoin[{$UserBaseDirectory, \"Applications\", \"HPL\"}];
<< NCAlgebra`;
<< PolyLogTools.m;

(* Drinfeld, GenerateNCFactor, GenerateNCWords, RegHPLat1.
   Always address companion files through NotebookDirectory[]: PolyLogTools \
pops
   the directory stack, so Directory[] does not stay put. *)
Get[FileNameJoin[{NotebookDirectory[], \"drinfeldAssociator.m\"}]];\
\>", "Input",ExpressionUUID->"5846cba5-1614-4b8e-9437-610d210b0910"],

Cell["Symbols", "Section",ExpressionUUID->"cea23c0f-4f74-4e47-91a1-074c6a55fd50"],

Cell["\<\
SetNonCommutative[a,b]
SetNonCommutative[e]
SetNonCommutative[x,y]
SetAttributes[e,Orderless];
Format[e[i_,j_]]:=Subscript[e,i,j]
Format[x[i_]]:=Subscript[x,i]
Format[y[i_]]:=Subscript[y,i]
e[i_,i_]=0;
el[j_,n_]:=Sum[e[k,j],{k,1,j}]     (* e_j^<   *)
eg[j_,n_]:=Sum[e[k,j],{k,j+1,n}]   (* e_j^>   *)

(* Mandelstam invariants.  Throughout, E_ij = s_ij + e_ij. *)
SetAttributes[ss,Orderless];
ss[i_,i_]=0;
Format[ss[i_,j_]]:=Subscript[s,i,j]

{el[2,5], el[3,5], eg[2,5]}\
\>", "Input",ExpressionUUID->"0e2c5053-9cc8-441f-8cbd-fc14f907748b"],

Cell["\<\
Braid algebra: permutations, truncation, momentum conservation\
\>", "Section",ExpressionUUID->"cdd80d92-f980-4804-ac4c-fd4fb854b2fe"],

Cell["\<\
Perm[p_List, expr_]  := expr /. e[i_,j_]  :> e[p[[i]],p[[j]]]     (* the \
action of tau-hat on braid generators *)
PermS[p_List, expr_] := expr /. ss[i_,j_] :> ss[p[[i]],p[[j]]]
prodR[f_, a_, b_] := Fold[NCExpand[#1 ** #2] &, 1, f /@ Range[a, b]]     (* \
f[a] ** ... ** f[b] *)
prodL[f_, a_, b_] := Fold[NCExpand[#1 ** #2] &, 1, f /@ Range[b, a, -1]] (* \
f[b] ** ... ** f[a]  : the \"left arrow\" product *)

(* Truncation by total degree in the braid generators.  The bookkeeping \
symbol
   must not be a single lower-case letter: NCAlgebra declares all of those
   non-commutative, and Coefficient then cannot pull it out. *)
wtTrunc[expr_, w_] := Module[{ex},
  ex = NCExpand[expr /. e[i_,j_] :> tWgt e[i,j]];
  Sum[Coefficient[ex, tWgt, k], {k, 0, w}]]
eTrunc[expr_, w_] := wtTrunc[expr, w]

(* Solving momentum conservation for the dependent letters *)
allVars[n_] := \
DeleteDuplicates[DeleteCases[Flatten[Table[e[i,j],{i,1,n},{j,1,n}]],0]]
indMom[n_]  := \
DeleteDuplicates[DeleteCases[Flatten[Table[e[i,j],{i,1,n-1},{j,2,n-2}]],0]]
momCons[n_] := Flatten[Table[Sum[e[i,j],{j,1,n}]==0,{i,1,n}]]
consRules[n_] := consRules[n] = Solve[momCons[n], \
Complement[allVars[n],indMom[n]]][[1]]

allVarsS[n_] := \
DeleteDuplicates[DeleteCases[Flatten[Table[ss[i,j],{i,1,n},{j,1,n}]],0]]
indMomS[n_]  := \
DeleteDuplicates[DeleteCases[Flatten[Table[ss[i,j],{i,1,n-1},{j,2,n-2}]],0]]
momConsS[n_] := Flatten[Table[Sum[ss[i,j],{j,1,n}]==0,{i,1,n}]]
consRulesS[n_] := consRulesS[n] = Solve[momConsS[n], \
Complement[allVarsS[n],indMomS[n]]][[1]]

(* Generating all possible NC factors *)
GenerateNCFactor[elements_List, maxLength_] := Module[{words},
  words = Flatten[Table[Tuples[elements, n], {n, 2, maxLength}], 1];
  Flatten[Join[elements, NonCommutativeMultiply @@ # & /@ words]]]
NCFactorsAtMul[n_,weight_] := GenerateNCFactor[indMom[n],weight]

{indMom[5], consRules[5]}\
\>", "Input",ExpressionUUID->"ca402c4a-d7e0-4d62-a62e-1bbb807584e8"],

Cell["PBW normal form", "Section",ExpressionUUID->"07a0e16c-ad10-4161-875c-53825dded5b3"],

Cell["\<\
(* Normal form algorithm *)
eToXY = {e[1,3]->x[1], e[2,3]->x[2], e[3,4]->x[3], e[1,2]->y[1], e[2,4]->y[2]};
xyToE = {x[1]->e[1,3], x[2]->e[2,3], x[3]->e[3,4], y[1]->e[1,2], y[2]->e[2,4]};

(* [y_j, x_i] as {coeff, x-word} pairs *)
br[1, 1] = {{ 1, {x[1], x[2]}}, {-1, {x[2], x[1]}}};
br[1, 2] = {{-1, {x[1], x[2]}}, { 1, {x[2], x[1]}}};
br[1, 3] = {};
br[2, 1] = {};
br[2, 2] = {{ 1, {x[2], x[3]}}, {-1, {x[3], x[2]}}};
br[2, 3] = {{-1, {x[2], x[3]}}, { 1, {x[3], x[2]}}};

Clear[nfWord];
nfWord[w_List] := nfWord[w] = Module[{k, j, i, pre, post, res},
   k = FirstPosition[Partition[w, 2, 1], {y[_], x[_]}, {0}][[1]];
   If[k === 0,
    <|w -> 1|>,                                  (* already normal *)
    j = w[[k, 1]]; i = w[[k + 1, 1]];
    pre = Take[w, k - 1]; post = Drop[w, k + 1];
    res = nfWord[Join[pre, {w[[k + 1]], w[[k]]}, post]];
    Do[res = Merge[{res, (c[[1]] #) & /@ nfWord[Join[pre, c[[2]], post]]}, \
Total],
       {c, br[j, i]}];
    DeleteCases[res, 0]]];

letters[ex_] := Replace[ex, {
   NonCommutativeMultiply[a__] :> Flatten[letters /@ {a}],
   Power[a_, n_Integer] :> Flatten[ConstantArray[letters[a], n]],
   z_ :> {z}}];

split[t_] := Module[{fs = If[Head[t] === Times, List @@ t, {t}]},
   {Times @@ Select[fs, FreeQ[#, x | y] &],
    Flatten[letters /@ Select[fs, ! FreeQ[#, x | y] &]]}];

toNC[w_List] := If[w === {}, 1, NonCommutativeMultiply @@ w];

NF[expr_] := Module[{ex = NCExpand[expr], ts},
   ts = If[Head[ex] === Plus, List @@ ex, {ex}];
   Total[Function[t, Module[{c, w}, {c, w} = split[t];
       c Total[KeyValueMap[#2 toNC[#1] &, nfWord[w]]]]] /@ ts]];

(* length of a normal-form monomial *)
wordLen[k_] := If[k === 1, 0, Length[letters[k]]]

(* <| basis word -> coefficient |> of a normal-ordered expression *)
nfCollect[expr_] := Module[{ex = NCExpand[expr], ts},
   ts = If[Head[ex] === Plus, List @@ ex, {ex}];
   DeleteCases[Merge[(Module[{c, w}, {c, w} = split[#]; toNC[w] -> c]) & /@ \
ts, Total], 0]];

(* e-expression  ->  truncated normal form in the x,y basis *)
toNF[expr_, w_] := NF[NCExpand[wtTrunc[NCExpand[expr /. consRules[5]], w] /. \
eToXY]]

(* truncation and product directly in the x,y basis *)
truncXY[expr_, w_] := Module[{ex},
  ex = NCExpand[expr /. {x[i_] :> tW2 x[i], y[i_] :> tW2 y[i]}];
  Sum[Coefficient[ex, tW2, k], {k, 0, w}]]
mulNF[A_, B_, w_] := NF[truncXY[NCExpand[A ** B], w]]\
\>", "Input",ExpressionUUID->"8f92ddfc-8d77-46de-b6c6-f0e3577e0292"],

Cell["Chambers and crossing factors", "Section",ExpressionUUID->"009cefbb-d640-4f0f-ab59-b273d414edec"],

Cell["\<\
(* chamber orderings tau_j *)
tauP[1, n_] := Join[{2,1}, Range[3,n]]
tauP[2, n_] := Range[n]
tauP[j_, n_] := Join[{1}, Range[3,j], {2}, Range[j+1,n]] /; 2 < j <= n-1

(* non-commutative exponential, truncated *)
ncPow[u_, 0] := 1
ncPow[u_, k_Integer?Positive] := NCExpand[ncPow[u, k-1] ** u]
ncExpT[u_, w_] := Sum[ncPow[u, k]/k!, {k, 0, w}]

(* e^{sg i pi E_ij} = e^{sg i pi s_ij} e^{sg i pi e_ij} *)
phaseE[i_, j_, sg_, w_] := Exp[sg I Pi ss[i,j]] ncExpT[sg I Pi e[i,j], w]

(* crossing factor C^{(1 3 ... k-1)}_{2 -> k} *)
Cfac[k_, n_, w_] := Cfac[k, n, w] = NCExpand[
     Drinfeld[e[2,k], Perm[tauP[k,n], el[k-1,n]], w]
  ** phaseE[2, k, -1, w]
  ** Drinfeld[Perm[tauP[k-1,n], el[k-1,n]], e[2,k], w]]

(* the ordered product of crossing factors multiplying Z(tau_j|rho) *)
Mfac[j_, n_, w_] := Mfac[j, n, w] = NCExpand[prodL[Cfac[#, n, w] &, 3, j]]

Column[{
  Row[{\"chambers: \", Table[tauP[j,5], {j,1,4}]}],
  Sequence @@ Table[
    Row[{\"C_{2->\", k, \"} = \\[CapitalPhi][\", Perm[{1,2,3,4,5},e[2,k]], \
\", \",
         Perm[tauP[k,5], el[k-1,5]], \"] e^{-i \\[Pi] E_{2\", k, \"}} \
\\[CapitalPhi][\",
         Perm[tauP[k-1,5], el[k-1,5]], \", \", Perm[{1,2,3,4,5},e[2,k]], \
\"]\"}], {k,3,4}]}]\
\>", "Input",ExpressionUUID->"36fe3146-50c0-4072-9bad-04c6e36a4159"],

Cell["Symbolic Z-integrals", "Section",ExpressionUUID->"c49ffd6d-2b56-4c6f-b69c-b6e0adb04bff"],

Cell["\<\
(* alphabet of L_k: the singularity labels and the corresponding braid letters.
   Labels are PUNCTURE numbers 1..n, never positions: which point sits at 0, \
1 or
   Infinity is chamber data, read off from tau.  These are the labels of the
   REFERENCE chamber 12...n; Zsym pushes them to tau via lblPerm.  Label 1 is
   the puncture at the origin, so for k >= 2 its letter is the block sum
   e_{k+1}^< = el[k+1,n], punctures 1..k having already collapsed there. *)
albl[k_, n_] := Join[{1}, Table[m, {m, k+2, n-2}], {n-1}]
alet[k_, n_] := Join[{el[k+1,n]}, Table[e[m,k+1], {m, k+2, n-2}], {e[n-1,k+1]}]

wordsUpTo[alph_, w_] := Flatten[Table[Tuples[alph, l], {l, 0, w}], 1]
lblToLet[k_, n_, w_List] := Module[{lookup = AssociationThread[albl[k,n] -> \
alet[k,n]]},
  If[w === {}, 1, NonCommutativeMultiply @@ (lookup /@ w)]]

(* all tuples of words {w_1,...,w_{n-3}} of total weight <= w *)
multiWords[n_, w_] := Select[Tuples[Table[wordsUpTo[albl[k,n], w], {k, 1, \
n-3}]],
                             Total[Length /@ #] <= w &]
Gword[n_, ww_] := NCExpand[NonCommutativeMultiply @@ Table[lblToLet[k, n, \
ww[[k]]], {k, 1, n-3}]]

(* string labels *)
lblChar[m_Integer] := ToString[m]
wordStr[w_List] := StringJoin[lblChar /@ w]
permStr[p_List] := StringJoin[ToString /@ p]
(* Labels travel with the chamber.  The letter sitting in slot k of Z^tau is
   Perm[tau, .] of the reference letter, so its singularity is at puncture
   tau[[l]], not l; the integrated variable is the position of tau[[k+1]]. *)
lblPerm[tau_, w_List] := tau[[#]] & /@ w
Zsym[tau_, rho_, ww_] := Zc[permStr[tau], permStr[rho],
  Sequence @@ (wordStr[lblPerm[tau, #]] & /@ ww)]

(* the symbolic generating series *)
Zser[tau_, rho_, n_, w_] :=
  Total[(NCExpand[Perm[tau, Gword[n, #]]] Zsym[tau, rho, #]) & /@ \
multiWords[n, w]]

(* decode a symbol back to the data defining its integral *)
ZcDecode[Zc[tt_String, rr_String, uu_String, vv_String]] := Module[{tau = \
ToExpression /@ Characters[tt]}, <|
  \"chamber\" -> tau,
  \"PT\"      -> ToExpression /@ Characters[rr],
  \"vars\"    -> tau[[2 ;; -3]],   (* punctures whose positions are \
integrated *)
  \"word z2\" -> ToExpression /@ Characters[uu],
  \"word z3\" -> ToExpression /@ Characters[vv]|>]

Format[Zc[tt_String, rr_String, uu_String, vv_String]] :=
  Row[{Superscript[\"Z\", tt], \"[\", rr, \"|\", uu, \",\", vv, \"]\"}]

Zser[tauP[3,5], {1,2,3,4,5}, 5, 1]\
\>", "Input",ExpressionUUID->"d6bac298-3ca0-4833-8485-7d3dae535bd1"],

Cell["Assembling the relation", "Section",ExpressionUUID->"c3df9373-c781-41bc-8087-af7a7d5bf328"],

Cell["\<\
CfacNF[k_, n_, w_]         := CfacNF[k,n,w]      = toNF[Cfac[k,n,w], w]
MfacNF[j_, n_, w_]         := MfacNF[j,n,w]      = Fold[mulNF[#1,#2,w]&, 1, \
CfacNF[#,n,w]& /@ Range[j,3,-1]]
ZserNF[tau_, rho_, n_, w_] := ZserNF[tau,rho,n,w] = toNF[Zser[tau,rho,n,w], \
w]
phaseNF[i_, j_, sg_, w_]   := toNF[phaseE[i,j,sg,w], w]

MonRelNF[rho_, n_, w_] := NF[
    mulNF[ZserNF[tauP[1,n],rho,n,w], phaseNF[1,2,+1,w], w]
  + ZserNF[tauP[2,n],rho,n,w]
  + Sum[mulNF[ZserNF[tauP[j,n],rho,n,w], MfacNF[j,n,w], w], {j, 3, n-1}]]

(* one scalar relation per basis word *)
MonEqs[rho_, n_, w_] := nfCollect[MonRelNF[rho, n, w]]\
\>", "Input",ExpressionUUID->"00443b6d-89ac-43a0-ad75-cf3ba87724f8"],

Cell["The relations at Wmax = 2", "Section",ExpressionUUID->"d4f71802-57ae-418b-a4ae-6ef984cc30fc"],

Cell["\<\
n = 5;
rho = {1,2,3,4,5};
Wmax = 2;

{timing, eqs} = AbsoluteTiming[MonEqs[rho, n, Wmax]];
zsyms = DeleteDuplicates[Cases[Values[eqs], _Zc, Infinity]];

Column[{
  Row[{\"weight truncation       : \", Wmax}],
  Row[{\"basis words (equations) : \", Length[eqs]}],
  Row[{\"Z integrals appearing   : \", Length[zsyms]}],
  Row[{\"time                    : \", Round[timing, 0.01], \" s\"}]}]\
\>", "Input",ExpressionUUID->"9011de56-60b1-4774-8dac-5d5338b6beb5"],

Cell["Export", "Section",ExpressionUUID->"ea11dc47-4f81-43c0-9a05-f78e32a04d6a"],

Cell["\<\
outFile = FileNameJoin[{NotebookDirectory[], \"monEqs5_W\" <> ToString[Wmax] \
<> \".m\"}];
Put[<|\"Wmax\" -> Wmax, \"rho\" -> rho, \"equations\" -> Normal[eqs], \
\"integrals\" -> zsyms|>, outFile];
outFile\
\>", "Input",ExpressionUUID->"5189d05e-2380-48ec-98ea-28a89dfa92af"]
},

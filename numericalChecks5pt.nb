Cell[CellGroupData[{

Cell["The kinematic point", "Section",ExpressionUUID->"a0a99152-7817-4ea9-b62d-1712b96e5a29"],

Cell["\<\
The relation mixes the four chambers 12345, 13245, 13425 and 21345, so the \
Mandelstam point must sit inside the domain of convergence of all four at \
once.  Reading the facet exponents off the puncture collisions and demanding \
every one exceed -1 gives

    s12, s23, s34, s45, s15 > 0        and        s13, s24, s25 > -1.

The point below clears all eight conditions\
\>", "Text",
 CellChangeTimes->{{3.997879454835381*^9, 
  3.9978794656491547`*^9}},ExpressionUUID->"4f0ab308-4f2c-4a21-83a3-\
d20fec5b80c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "s12", ",", " ", "s23", ",", " ", "s34", ",", " ", "s45", ",", " ", 
     "s15"}], "}"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sMon", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "5"}], ",", " ", 
       RowBox[{"3", "/", "10"}], ",", " ", 
       RowBox[{"2", "/", "5"}], ",", " ", 
       RowBox[{"3", "/", "5"}], ",", " ", 
       RowBox[{"7", "/", "20"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"sBasis5", ",", " ", "sMon"}], "}"}], "]"}], ",", "\n", 
         "       ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{
              RowBox[{"toBasis5", "[", "#", "]"}], " ", "/.", " ", 
              RowBox[{"sChoice", "[", "sMon", "]"}]}]}], "}"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"1", ",", " ", "3"}], "]"}], ",", " ", 
            RowBox[{"s", "[", 
             RowBox[{"2", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"s", "[", 
             RowBox[{"2", ",", " ", "5"}], "]"}], ",", " ", 
            RowBox[{"s", "[", 
             RowBox[{"1", ",", " ", "4"}], "]"}], ",", " ", 
            RowBox[{"s", "[", 
             RowBox[{"3", ",", " ", "5"}], "]"}]}], "}"}]}]}], "]"}], ",", 
       "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<invariant\>\"", ",", " ", "\"\<value\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"63e4c93e-1304-43e4-99c4-e8cfcf85cc28"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"invariant\"\>", "\<\"value\"\>"},
    {
     RowBox[{"s", "[", 
      RowBox[{"1", ",", "2"}], "]"}], 
     FractionBox["1", "5"]},
    {

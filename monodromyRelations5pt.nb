        RowBox[{"\"\<chamber\>\"", " ", "->", " ", "tau"}], ",", "\n", "  ", 
        RowBox[{"\"\<PT\>\"", "      ", "->", " ", 
         RowBox[{"ToExpression", " ", "/@", " ", 
          RowBox[{"Characters", "[", "rr", "]"}]}]}], ",", "\n", "  ", 
        RowBox[{"\"\<vars\>\"", "    ", "->", " ", 
         RowBox[{"tau", "[", 
          RowBox[{"[", 
           RowBox[{"2", " ", ";;", " ", 
            RowBox[{"-", "3"}]}], "]"}], "]"}]}], ",", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "punctures", " ", "whose", " ", "positions", " ", "are", " ", 
          "integrated"}], " ", "*)"}], "\n", "  ", 
        RowBox[{"\"\<word z2\>\"", " ", "->", " ", 
         RowBox[{"ToExpression", " ", "/@", " ", 
          RowBox[{"Characters", "[", "uu", "]"}]}]}], ",", "\n", "  ", 
        RowBox[{"\"\<word z3\>\"", " ", "->", " ", 
         RowBox[{"ToExpression", " ", "/@", " ", 
          RowBox[{"Characters", "[", "vv", "]"}]}]}]}], "|>"}]}], "]"}]}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"Format", "[", 
     RowBox[{"Zc", "[", 
      RowBox[{
      "tt_String", ",", " ", "rr_String", ",", " ", "uu_String", ",", " ", 

Cell[CellGroupData[{

Cell["The 25 residuals", "Section",ExpressionUUID->"d98bd46d-75d3-4ed3-b4d0-d4b29fedd26a"],

Cell["\<\
Each relation is a linear combination of Z-integrals with coefficients in the \
Mandelstam invariants; numS puts the coefficients on the independent basis \
and substitutes the point, so a relation that holds returns zero.  What is \
left is quadrature error.\
\>", "Text",ExpressionUUID->"c8cdeb6e-c0e5-4963-af6e-04888e641673"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"resid", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"numS", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"monData", "[", "\"\<equations\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"k", ",", " ", "2"}], "]"}], "]"}], " ", "/.", " ", 
         "zVals"}], ",", " ", "sMon"}], "]"}], ",", "\n", "              ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{"Length", "[", 
         RowBox[{"monData", "[", "\"\<equations\>\"", "]"}], "]"}]}], "}"}]}],
      "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"monData", "[", "\"\<equations\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"Abs", "[", 
            RowBox[{"resid", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"resid", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], "/", "maxZ"}]}], "}"}], ",",
          "\n", "               ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", 
           RowBox[{"Length", "[", "resid", "]"}]}], "}"}]}], "]"}], ",", " ", 
       
       RowBox[{
        RowBox[{"-", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<basis word\>\"", ",", " ", "\"\<|residual|\>\"", ",", 
       " ", "\"\<relative\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"e024a02f-d63f-4dec-8a74-513034aff5f8"],


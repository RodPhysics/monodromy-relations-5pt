         RowBox[{"Zsym", "[", 
          RowBox[{"tau", ",", " ", "rho", ",", " ", "#"}], "]"}]}], ")"}], 
       " ", "&"}], " ", "/@", " ", 
      RowBox[{"multiWords", "[", 
       RowBox[{"n", ",", " ", "w"}], "]"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "decode", " ", "a", " ", "symbol", " ", "back", " ", "to", " ", "the", " ",
      "data", " ", "defining", " ", "its", " ", "integral"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ZcDecode", "[", 
     RowBox[{"Zc", "[", 
      RowBox[{
      "tt_String", ",", " ", "rr_String", ",", " ", "uu_String", ",", " ", 

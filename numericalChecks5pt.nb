Notebook[{

Cell[CellGroupData[{
Cell["Numerical check of the five-point monodromy relations", "Title",ExpressionUUID->"8b61296e-5ec8-421f-9b6a-de622ea8a1a7"],

Cell["\<\
All 25 monodromy relations produced by monodromyRelations5pt.nb are checked \
numerically at a single kinematic point, by evaluating the 100 Z-integrals \
they contain and substituting.

Nothing outside Mathematica is needed: no NCAlgebra, no PolyLogTools, no HPL, \
no ginsh.  zNumerics.m is plain Wolfram Language -- every multiple \
polylogarithm appearing at weight 2 has an elementary closed form.\
\>", "Text",
 CellChangeTimes->{{3.99787937991572*^9, 
  3.997879381402336*^9}},ExpressionUUID->"d3306bf7-dd9c-47e0-8ba9-\
8c872b333017"],

Cell[CellGroupData[{

Cell["Load", "Section",ExpressionUUID->"72a1e537-16fb-4833-bfb1-59bc0acc8c16"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbDir", " ", "=", " ", 
   RowBox[{"NotebookDirectory", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"nbDir", ",", " ", "\"\<zNumerics.m\>\""}], "}"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"monData", " ", "=", " ", 
    RowBox[{"Get", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"nbDir", ",", " ", "\"\<monEqs5_W2.m\>\""}], "}"}], "]"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zList", " ", "=", " ", 
    RowBox[{"Union", "@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"monData", "[", "\"\<equations\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", "_Zc", ",", 
       " ", "Infinity"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<weight truncation  : \>\"", ",", " ", 
       RowBox[{"monData", "[", "\"\<Wmax\>\"", "]"}]}], "}"}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Parke-Taylor order : \>\"", ",", " ", 
       RowBox[{"monData", "[", "\"\<rho\>\"", "]"}]}], "}"}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<relations          : \>\"", ",", " ", 
       RowBox[{"Length", "[", 
        RowBox[{"monData", "[", "\"\<equations\>\"", "]"}], "]"}]}], "}"}], 
     "]"}], ",", "\n", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<distinct Z's       : \>\"", ",", " ", 
       RowBox[{"Length", "[", "zList", "]"}]}], "}"}], "]"}], ",", "\n", "  ", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<packages loaded    : \>\"", ",", "\n", "       ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Names", "[", "\"\<NCAlgebra`*\>\"", "]"}], " ", "===", 
           " ", 
           RowBox[{"{", "}"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Names", "[", "\"\<PolyLogTools`*\>\"", "]"}], " ", "===", 
           " ", 
           RowBox[{"{", "}"}]}]}], ",", "\n", 
         "          ", "\"\<none - stock kernel\>\"", ",", 
         " ", "\"\<NCAlgebra / PolyLogTools present\>\""}], "]"}]}], "}"}], 
     "]"}]}], "}"}], "]"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"24d18584-3812-46b1-8059-2918f13b85dc"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{"\"weight truncation  : \"", "2"},
      "RowDefault"]},
    {
     TemplateBox[{"\"Parke-Taylor order : \"", 
       RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]},
